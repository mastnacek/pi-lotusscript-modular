' POZOR: Option Public/Declare - SMAŽ pokud už jsou v (Globals) → (Options)!
' Samostatný .lss soubor = nech, Form/Agent event = zkontroluj (Globals)
Option Public
Option Declare

'**********************************************************************
' NÁZEV: <nazev-souboru>.lss
' ÚČEL: <Stručný popis>
' AUTOR: <Jméno>
' VYTVOŘENO: <YYYY-MM-DD>
' ZÁVISLOSTI: (doplň seznam knihoven/agentů, nebo smaž tento řádek)
'
' VERZE: 0.1
' CHANGELOG:
'   0.1 (<YYYY-MM-DD>) - Základní implementace
'**********************************************************************

'===== KONSTANTY =====
' Jediné místo, kde se určuje kam chyby chodí. Změň jen tady.
Const ERROR_NOTIFY_EMAIL$ = "sluzbyict@veba.cz"
Const MAIL_SERVER$ = "domino/VEBA"
Const MAIL_DB$ = "mail.box"

' GetThreadInfo indexy - Option Declare vyžaduje konstanty místo čísel.
'
' !!! Při vkládání tohoto souboru do SCRIPT LIBRARY nebo design elementu
' !!! v Designeru tento celý blok SMAŽ (4 řádky Const LSI_THREAD_*).
' !!! Designer vkládá LSPRVAL.LSS automaticky a vlastní deklarace končí
' !!! chybou "Name previously declared: LSI_THREAD_PROC" (gotcha #39).
' !!! Bez toho bloku fungují - jen pro samostatné .lss mimo Designer.
' !!! MB_* a PICKLIST_* jsou z jiného souboru: v Script Library potřebují
' !!! %Include "lsconst.lss", v design elementu je Designer dodá sám.
Const LSI_THREAD_PROC = 1			' GetThreadInfo(1)  - aktuální procedura
Const LSI_THREAD_MODULE = 10		' GetThreadInfo(10) - aktuální modul
Const LSI_THREAD_CALLPROC = 11		' GetThreadInfo(11) - volající procedura
Const LSI_THREAD_CALLMODULE = 12	' GetThreadInfo(12) - volající modul

'===== POMOCNÉ FUNKCE =====

Sub SendErrorEmail(recipient As String, procName As String, moduleName As String, callerProc As String, callerModule As String)
	'**********************************************************************
	' Odešle chybový email s detaily o chybě
	' PARAMETRY:
	'   recipient (String)    - Email příjemce notifikace
	'   procName (String)     - Název procedury, ve které chyba nastala
	'   moduleName (String)   - Název modulu, ve kterém chyba nastala
	'   callerProc (String)   - Název volající procedury
	'   callerModule (String) - Název volajícího modulu
	' POZNÁMKY: GetThreadInfo se čte na labelu v původní proceduře a
	'           sem se předává - uvnitř této procedury by vracelo "SendErrorEmail".
	'           On Error Resume Next chrání proti chybě v error handleru.
	'**********************************************************************

	On Error Resume Next

	' Chytit info HNED, než ho přepíše cokoliv jiného
	Dim errNum As Integer
	Dim errLine As Long
	Dim errMsg As String
	errNum = Err
	errLine = Erl
	errMsg = Error$

	Dim session As New NotesSession
	Dim mailDb As New NotesDatabase(MAIL_SERVER$, MAIL_DB$)
	If Not mailDb.IsOpen Then
		Print "CHYBA: nelze otevřít " & MAIL_DB$ & " na " & MAIL_SERVER$
		Exit Sub
	End If

	Dim memo As New NotesDocument(mailDb)
	memo.Form = "Memo"
	memo.SendTo = recipient
	memo.Recipients = recipient
	memo.Subject = "[CHYBA] " & procName & " - " & moduleName
	memo.Body = "Cas: " & Format(Now, "DD.MM.YYYY HH:NN:SS") & Chr(10) & _
	            "Modul: " & moduleName & Chr(10) & _
	            "Procedura: " & procName & Chr(10) & _
	            "Volano z: " & callerProc & " / " & callerModule & Chr(10) & _
	            "Databaze: " & session.CurrentDatabase.Title & Chr(10) & _
	            "Cesta: " & session.CurrentDatabase.FilePath & Chr(10) & _
	            "Server: " & session.CurrentDatabase.Server & Chr(10) & _
	            "Uzivatel: " & session.UserName & Chr(10) & _
	            "Platforma: " & session.Platform & Chr(10) & _
	            Chr(10) & _
	            "Radek: " & Cstr(errLine) & Chr(10) & _
	            "Chyba #" & Cstr(errNum) & ": " & errMsg
	' Zapsat odeslanou poštu do složky, ne jen do outboxu
	memo.SaveMessageOnSend = True

	Call memo.Send(False)

	' Do logu agenta, i kdyby se email nepovedl - chyba nesmí zmizet
	Print "CHYBA v " & procName & " (" & moduleName & "), radek " & Cstr(errLine) & _
	      ": #" & Cstr(errNum) & " " & errMsg
End Sub

'===== HLAVNÍ RUTINA =====

Sub Initialize
	Dim session As New NotesSession
	Dim db As NotesDatabase

	On Error GoTo ErrorHandler

	' TODO: Hlavní kód zde

	Exit Sub

ErrorHandler:
	Call SendErrorEmail(ERROR_NOTIFY_EMAIL$, _
		GetThreadInfo(LSI_THREAD_PROC), GetThreadInfo(LSI_THREAD_MODULE), _
		GetThreadInfo(LSI_THREAD_CALLPROC), GetThreadInfo(LSI_THREAD_CALLMODULE))
	Exit Sub
End Sub