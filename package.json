{
  "name": "pi-lotusscript-modular",
  "version": "0.2.0",
  "description": "Pi extension for modular LotusScript compilation (manifest sync, settle-time recompile), scaffolding and LSP diagnostics for Notes/Domino 9.0.1",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastnacek/pi-lotusscript-modular.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "lotusscript",
    "lotus-notes",
    "domino",
    "dxl",
    "modular"
  ],
  "author": "mastnacek",
  "license": "MIT",
  "scripts": {
    "test": "npx tsx test/test_i18n.ts && npx tsx test/test_workflow.ts && npx tsx test/test_versioning.ts && npx tsx test/test_drift.ts && npx tsx test/test_trace.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "skills",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typebox": "^1.3.19",
    "typescript": "^5.8.0"
  }
}
